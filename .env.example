# Keep this file secret in deployment; never commit a real token.
DISCORD_TOKEN=
# Numeric Discord user ID allowed to use bot-owner commands.
BOT_OWNER_ID=
DATABASE_PATH=data/esn_guardian.db
LOG_LEVEL=INFO

# ESN SMP Bedrock status monitor
MC_HOST=esn.ggwp.cc
MC_PORT=17429

# Guardian v7 optional external protection services
# Expose the read-only /health endpoint only if your host gives you a protected port.
GUARDIAN_DASHBOARD_PORT=
GUARDIAN_DASHBOARD_TOKEN=
# A second watchdog service can poll the dashboard URL.
GUARDIAN_STATUS_URL=
GUARDIAN_ALERT_WEBHOOK=
# Optional off-host verified database backup receiver.
GUARDIAN_BACKUP_ENDPOINT=
GUARDIAN_BACKUP_TOKEN=
# Optional privacy-preserving shared threat-intelligence endpoint.
GUARDIAN_THREAT_INTEL_ENDPOINT=
GUARDIAN_THREAT_INTEL_TOKEN=
GUARDIAN_INTEL_SALT=
# Optional HMAC key for signed deployment manifests.
GUARDIAN_RELEASE_HMAC_KEY=
# Emergency override only. Leave blank/0 in production.
GUARDIAN_ALLOW_INTEGRITY_FAILURE=0
